        Desc = "Digite o novo nome antes de clicar em Renomear.",
        Value = TAS_CURRENT_NAME,
        Placeholder = "Ex.: EB_Torre_A",
        InputIcon = "pencil",
        Callback = function(value) end,
    })

    TAS_SAVED_DROPDOWN = AddElement("Dropdown", {
        Title = "Meus TAS salvos",
