                    TASStop()
                    Notify("TAS", "Reprodução interrompida.", 2)
                end
            end
        end,
    })

    AddElement("Button", {
        Title = "🗑 Excluir TAS selecionado",
        Desc = "Remove a gravação da biblioteca local.",
        Icon = "trash-2",
