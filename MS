--========================================================--
-- TAS | SISTEMA PRÓPRIO DO MAKIMA SCRIPTS
--========================================================--
--
-- Formato próprio JSON:
--   Version, Name, PlaceId, StartCFrame e Frames.
--
-- O sistema grava a trajetória do personagem, desenha a linha da
-- trajetória e consegue exportar/importar os TAS usando as APIs de
-- arquivo do executor (writefile/readfile/isfile).
--
-- Os TAS desta versão usam o formato próprio do Makima.

local TAS_FOLDER = "MakimaScripts/TAS"
local TAS_SAVED_FOLDER = TAS_FOLDER .. "/Saved"
local TAS_VERSION = 1
local TAS_RECORD_FPS = 30
local TAS_AUTO_START = true
local TAS_AUTO_WALK = true
local TAS_START_RADIUS = 5
local TAS_ENABLED = false
local TAS_PLAYING = false
local TAS_RECORDING = false
local TAS_SESSION = nil
local TAS_FRAMES = {}
local TASCurrentName = "MeuTAS"
local TASAutoTriggered = false
local TAS_LAST_DATA = nil
local TAS_TRAJECTORY_FOLDER = nil
local TAS_WALKING = false
local TAS_STOP_REQUESTED = false

local function TASFileAPI()
    return type(writefile) == "function"
        and type(readfile) == "function"
        and type(isfile) == "function"
end

local function TASNormalizeName(name)
    name = tostring(name or "MeuTAS")
    name = name:gsub("[^%w_%-%s]", "")
    name = name:gsub("%s+", "_")
    if name == "" then
        name = "MeuTAS"
    end
    return name
end

local function TASEnsureFolder()
    if type(makefolder) ~= "function" then
        return true
    end

    pcall(function()
        if type(isfolder) ~= "function" or not isfolder("MakimaScripts") then
            makefolder("MakimaScripts")
        end
        if type(isfolder) ~= "function" or not isfolder(TAS_FOLDER) then
            makefolder(TAS_FOLDER)
        end
        if type(isfolder) ~= "function" or not isfolder(TAS_SAVED_FOLDER) then
            makefolder(TAS_SAVED_FOLDER)
        end
    end)

    return true
end

local function TASPath(name)
    return TAS_FOLDER .. "/" .. TASNormalizeName(name) .. ".json"
end

local function TASSavedPath(name)
    return TAS_SAVED_FOLDER .. "/" .. TASNormalizeName(name) .. ".json"
end

local TAS_START_MARKER = nil

local function TASClearTrajectory()
    if TAS_TRAJECTORY_FOLDER then
        pcall(function()
            TAS_TRAJECTORY_FOLDER:Destroy()
        end)
    end
    TAS_TRAJECTORY_FOLDER = nil
    if TAS_START_MARKER then
        pcall(function() TAS_START_MARKER:Destroy() end)
        TAS_START_MARKER = nil
    end
end

local function TASDrawTrajectory(frames)
    TASClearTrajectory()

    if type(frames) ~= "table" or #frames < 2 then
        return
    end

    TAS_TRAJECTORY_FOLDER = Instance.new("Folder")
    TAS_TRAJECTORY_FOLDER.Name = "MakimaTASTrajectory"
    TAS_TRAJECTORY_FOLDER.Parent = workspace

    local lastPosition
    local step = math.max(1, math.floor(TAS_RECORD_FPS / 10))

    for i = 1, #frames, step do
        local frame = frames[i]
        if frame and frame.c then
            local cf = CFrame.new(table.unpack(frame.c))
            local position = cf.Position

            if lastPosition then
                local delta = position - lastPosition
                local length = delta.Magnitude
                if length > 0.05 then
                    local segment = Instance.new("Part")
                    segment.Name = "TASLine"
                    segment.Anchored = true
                    segment.CanCollide = false
                    segment.CanTouch = false
                    segment.CanQuery = false
                    segment.Material = Enum.Material.Neon
                    segment.Color = Color3.fromRGB(255, 45, 70)
                    segment.Transparency = 0.2
                    segment.Size = Vector3.new(0.12, 0.12, length)
                    segment.CFrame = CFrame.lookAt(
                        (lastPosition + position) / 2,
                        position
                    )
                    segment.Parent = TAS_TRAJECTORY_FOLDER
                end
            end

            lastPosition = position
        end
    end
end

local function TASCFrameToArray(cf)
    return { cf:GetComponents() }
end

local function TASArrayToCFrame(values)
    if type(values) ~= "table" or #values < 12 then
        return nil
    end

    local ok, cf = pcall(function()
        return CFrame.new(table.unpack(values))
    end)

    return ok and cf or nil
end

local function TASBuildData(name, frames)
    local first = frames[1]
    local startCFrame = first and TASArrayToCFrame(first.c) or nil

    return {
        Version = TAS_VERSION,
        Name = TASNormalizeName(name),
        PlaceId = game.PlaceId,
        CreatedAt = os.time(),
        SampleRate = TAS_RECORD_FPS,
        StartCFrame = startCFrame and TASCFrameToArray(startCFrame) or nil,
        Frames = frames,
    }
end

local function TASExport(name, data)
    if not TASFileAPI() then
        Notify("TAS", "Seu executor não suporta salvar arquivos.", 5)
        return false
    end

    TASEnsureFolder()

    local encoded
    local ok = pcall(function()
        encoded = HttpService:JSONEncode(data)
    end)

    if not ok or type(encoded) ~= "string" then
        Notify("TAS", "Não foi possível converter o TAS para JSON.", 5)
        return false
    end

    local path = TASPath(name)
    local saved = pcall(function()
        writefile(path, encoded)
    end)

    if not saved then
        Notify("TAS", "Não foi possível salvar: " .. path, 5)
        return false
    end

    TAS_LAST_DATA = data
    Notify("TAS exportado", path, 4)
    return true
end

local function TASSaveLocal(name, data)
    if not TASFileAPI() then
        Notify("TAS", "Seu executor não suporta salvar arquivos.", 5)
        return false
    end

    TASEnsureFolder()
    local encoded
    local ok = pcall(function()
        encoded = HttpService:JSONEncode(data)
    end)
    if not ok or type(encoded) ~= "string" then
        Notify("TAS", "Não foi possível preparar o TAS.", 5)
        return false
    end

    local path = TASSavedPath(name)
    local saved = pcall(function()
        writefile(path, encoded)
    end)
    if not saved then
        Notify("TAS", "Não foi possível salvar na sua Hub.", 5)
        return false
    end

    TAS_LAST_DATA = data
    Notify("TAS salvo", "Salvo somente no armazenamento local deste usuário.", 4)
    return true
end

local function TASLoadLocal(name)
    if not TASFileAPI() then
        Notify("TAS", "Seu executor não suporta leitura de arquivos.", 5)
        return nil
    end

    local path = TASSavedPath(name)
    if not isfile(path) then
        return nil
    end

    local raw
    local ok = pcall(function() raw = readfile(path) end)
    if not ok or type(raw) ~= "string" then
        return nil
    end

    local data
    ok = pcall(function() data = HttpService:JSONDecode(raw) end)
    if not ok or type(data) ~= "table" then
        return nil
    end

    if tonumber(data.Version) ~= TAS_VERSION or tonumber(data.PlaceId) ~= game.PlaceId then
        return nil
    end
    if type(data.Frames) ~= "table" or #data.Frames < 2 then
        return nil
    end
    return data
end

local function TASImport(name)
    if not TASFileAPI() then
        Notify("TAS", "Seu executor não suporta leitura de arquivos.", 5)
        return nil
    end

    local path = TASPath(name)
    if not isfile(path) then
        Notify("TAS", "Arquivo não encontrado: " .. path, 5)
        return nil
    end

    local raw
    local readOK = pcall(function()
        raw = readfile(path)
    end)

    if not readOK or type(raw) ~= "string" then
        Notify("TAS", "Não foi possível ler o arquivo.", 5)
        return nil
    end

    local data
    local decodeOK = pcall(function()
        data = HttpService:JSONDecode(raw)
    end)

    if not decodeOK or type(data) ~= "table" then
        Notify("TAS", "Arquivo TAS inválido.", 5)
        return nil
    end

    if tonumber(data.Version) ~= TAS_VERSION then
        Notify("TAS", "Versão do TAS incompatível.", 5)
        return nil
    end

    if tonumber(data.PlaceId) ~= game.PlaceId then
        Notify("TAS", "Esse TAS pertence a outro jogo/PlaceId.", 5)
        return nil
    end

    if type(data.Frames) ~= "table" or #data.Frames < 2 then
        Notify("TAS", "O TAS não possui frames suficientes.", 5)
        return nil
    end

    TAS_LAST_DATA = data
    TASDrawTrajectory(data.Frames)
    Notify("TAS importado", tostring(data.Name or name), 3)
    return data
end

local function TASGetCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    return character, humanoid, root
end

local function TASWaitForCharacter()
    for _ = 1, 100 do
        local character, humanoid, root = TASGetCharacter()
        if character and humanoid and root and humanoid.Health > 0 then
            return character, humanoid, root
        end
        task.wait(0.1)
    end
end

local function TASMoveToStart(targetCFrame)
    if not TAS_AUTO_WALK or not targetCFrame then
        return true
    end

    local character, humanoid, root = TASWaitForCharacter()
    if not humanoid or not root then
        return false
    end

    if (root.Position - targetCFrame.Position).Magnitude <= TAS_START_RADIUS then
        return true
    end

    TAS_WALKING = true
    TAS_STOP_REQUESTED = false

    local pathOK, path = pcall(function()
        local p = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            WaypointSpacing = 3,
        })
        p:ComputeAsync(root.Position, targetCFrame.Position)
        return p
    end)

    if pathOK and path and path.Status == Enum.PathStatus.Success then
        for _, waypoint in ipairs(path:GetWaypoints()) do
            if TAS_STOP_REQUESTED then
                TAS_WALKING = false
                return false
            end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)
            local reached = humanoid.MoveToFinished:Wait()
            if not reached and (root.Position - targetCFrame.Position).Magnitude > TAS_START_RADIUS then
                break
            end
        end
    else
        humanoid:MoveTo(targetCFrame.Position)
        local deadline = os.clock() + 12
        while os.clock() < deadline and not TAS_STOP_REQUESTED do
            if (root.Position - targetCFrame.Position).Magnitude <= TAS_START_RADIUS then
                break
            end
            task.wait(0.1)
        end
    end

    TAS_WALKING = false
    return not TAS_STOP_REQUESTED
end

local function TASStop()
    TAS_STOP_REQUESTED = true
    TAS_RECORDING = false
    TAS_PLAYING = false
    TAS_WALKING = false

    local _, humanoid, root = TASGetCharacter()
    if humanoid then
        humanoid:Move(Vector3.zero, false)
    end
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function TASStartRecording(name)
    if not TAS_ENABLED then
        Notify("TAS", "Ative o toggle do TAS primeiro.", 3)
        return
    end

    if TAS_RECORDING or TAS_PLAYING then
        Notify("TAS", "Pare o TAS atual antes de iniciar outro.", 4)
        return
    end

    local _, humanoid, root = TASWaitForCharacter()
    if not humanoid or not root then
        Notify("TAS", "Personagem não encontrado.", 4)
        return
    end

    TASClearTrajectory()
    TASCurrentName = TASNormalizeName(name)
    TAS_FRAMES = {}
    TAS_SESSION = {
        started = os.clock(),
        accumulator = 0,
        last = os.clock(),
    }
    TAS_RECORDING = true
    TAS_STOP_REQUESTED = false

    table.insert(TAS_FRAMES, {
        t = 0,
        c = TASCFrameToArray(root.CFrame),
    })

    Notify("TAS", "Gravação iniciada: " .. TASCurrentName, 3)
end

local function TASFinishRecording()
    if not TAS_RECORDING then
        return nil
    end

    TAS_RECORDING = false
    TAS_STOP_REQUESTED = false

    if #TAS_FRAMES < 2 then
        Notify("TAS", "Movimento insuficiente para criar um TAS.", 4)
        return nil
    end

    local data = TASBuildData(TASCurrentName, TAS_FRAMES)
    TAS_LAST_DATA = data
    TASDrawTrajectory(data.Frames)

    Notify("TAS", "Gravação concluída: " .. TASCurrentName, 3)
    return data
end

RunService.Heartbeat:Connect(function(dt)
    if TAS_RECORDING and TAS_SESSION then
        TAS_SESSION.accumulator += dt
        local interval = 1 / TAS_RECORD_FPS

        if TAS_SESSION.accumulator >= interval then
            TAS_SESSION.accumulator -= interval

            local _, _, root = TASGetCharacter()
            if root then
                local elapsed = os.clock() - TAS_SESSION.started
                table.insert(TAS_FRAMES, {
                    t = elapsed,
                    c = TASCFrameToArray(root.CFrame),
                })
            end
        end
    end
end)

local function TASPlay(data)
    if not TAS_ENABLED then
        Notify("TAS", "Ative o toggle do TAS primeiro.", 3)
        return
    end

    if TAS_RECORDING or TAS_PLAYING then
        Notify("TAS", "Pare o TAS atual antes de reproduzir outro.", 4)
        return
    end

    if type(data) ~= "table" or type(data.Frames) ~= "table" or #data.Frames < 2 then
        Notify("TAS", "Nenhum TAS válido carregado.", 4)
        return
    end

    local first = data.Frames[1]
    local startCFrame = first and TASArrayToCFrame(first.c)
    if not startCFrame then
        Notify("TAS", "O TAS não possui posição inicial válida.", 4)
        return
    end

    TAS_PLAYING = true
    TAS_STOP_REQUESTED = false

    task.spawn(function()
        local ok = TASMoveToStart(startCFrame)
        if not ok or TAS_STOP_REQUESTED then
            TAS_PLAYING = false
            return
        end

        local _, humanoid, root = TASWaitForCharacter()
        if not root then
            TAS_PLAYING = false
            return
        end

        -- Mantém o Humanoid em movimento para que a animação de caminhada
        -- continue tocando durante a reprodução. A versão anterior zerava
        -- a velocidade em todos os frames, fazendo o personagem parecer travado.
        local animate = root.Parent and root.Parent:FindFirstChild("Animate")
        if animate then
            pcall(function() animate.Disabled = false end)
        end
        pcall(function()
            humanoid.AutoRotate = false
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end)
        task.wait(0.05)

        local previousTime = 0
        local previousPosition = root.Position

        for _, frame in ipairs(data.Frames) do
            if TAS_STOP_REQUESTED or not TAS_PLAYING then
                break
            end

            local target = TASArrayToCFrame(frame.c)
            if target then
                local frameTime = tonumber(frame.t) or previousTime
                local delay = math.max(0, frameTime - previousTime)
                if delay > 0 then
                    task.wait(delay)
                end

                local _, currentHumanoid, currentRoot = TASGetCharacter()
                if currentRoot and currentHumanoid then
                    local delta = target.Position - previousPosition
                    local flat = Vector3.new(delta.X, 0, delta.Z)
                    if flat.Magnitude > 0.01 then
                        pcall(function()
                            currentHumanoid:Move(flat.Unit, false)
                            currentHumanoid:ChangeState(Enum.HumanoidStateType.Running)
                        end)
                    end
                    currentRoot.CFrame = target
                    if flat.Magnitude > 0.01 then
                        pcall(function()
                            currentHumanoid:Move(flat.Unit, false)
                        end)
                    end
                else
                    break
                end

                previousPosition = target.Position
                previousTime = frameTime
            end
        end

        pcall(function()
            humanoid:Move(Vector3.zero, false)
            humanoid.AutoRotate = true
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
        end)

        TAS_PLAYING = false
        TAS_STOP_REQUESTED = false
        Notify("TAS", "Reprodução concluída.", 3)
    end)
end

