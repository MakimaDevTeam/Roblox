local Hitboxes = {}

local parkourEnabled = false

local function getParkourData()

    local ok, source = pcall(function()

        return game:HttpGet(PARKOUR_SOURCE)

    end)

    if not ok or type(source) ~= "string" then
        return nil
    end

    local tableText =
        source:match(
            "local hitboxData%s*=%s*(%b{})"
        )

    if not tableText then
        return nil
    end

    local loadOk, data = pcall(function()

        return loadstring(
            "return " .. tableText
        )()

    end)

    if loadOk and type(data) == "table" then
        return data
    end

    return nil
end

local function createHitboxes()

    local hitboxData = getParkourData()

    if not hitboxData then

        notify(
            "Parkour",
            "Não foi possível carregar os pontos do Parkour.",
            4
        )

        return false
    end

    for _, v in ipairs(hitboxData) do

        local p = Instance.new("Part")

        p.Name = "MakimaScripts_Hitbox"

        p.Size = v.size

        p.Position = v.pos

        p.Anchored = true

        p.Transparency = 1

        p.CanCollide = false

        p.Parent = workspace

        local box = Instance.new("SelectionBox")

        box.Adornee = p

        box.Color3 =
            Color3.fromRGB(190, 20, 45)

        box.SurfaceColor3 =
            Color3.fromRGB(220, 30, 55)

        box.SurfaceTransparency = 0.5

        box.LineThickness = 0.08

        box.Parent = p

        table.insert(Hitboxes, p)

    end

    return true
end

local function clearHitboxes()

    for _, part in ipairs(Hitboxes) do

        pcall(function()
            part:Destroy()
        end)

    end

    table.clear(Hitboxes)
end

