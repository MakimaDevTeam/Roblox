local rotacaoSalva = nil

local function salvarRotacao()

    local char = player.Character

    local hrp =
        char and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if hrp then

        rotacaoSalva =
            hrp.CFrame.LookVector

    end
end

local function virarPersonagem(graus)

    local char = player.Character

    local hrp =
        char and char:FindFirstChild(
            "HumanoidRootPart"
        )

    if hrp then

        hrp.CFrame =
            hrp.CFrame
            * CFrame.Angles(
                0,
                math.rad(graus),
                0
            )

    end
end

