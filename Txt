            char and char:FindFirstChild(
                "HumanoidRootPart"
            )

        if hrp and rotacaoSalva then

            local posicaoAtual =
                hrp.Position

            hrp.CFrame =
                CFrame.new(
                    posicaoAtual,
                    posicaoAtual
                    + rotacaoSalva
                )

        end

    end,
})

